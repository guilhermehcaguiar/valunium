{
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "name": "valunium",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.34.9 <11"
  },
  "scripts": {
    "dev": "pnpm prisma:generate && turbo run dev",
    "build": "pnpm prisma:generate && turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm prisma:generate && turbo run typecheck && tsc -p tsconfig.tools.json",
    "test": "pnpm prisma:generate && turbo run test && node scripts/test-integration.mjs",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "tsx scripts/check-database.ts",
    "docs:check": "python3 scripts/verify_docs.py",
    "test:integration": "pnpm prisma:generate && pnpm --filter @valunium/shared build && pnpm --filter @valunium/financial-core build && pnpm --filter @valunium/api build && node scripts/test-integration.mjs",
    "test:browser": "pnpm build && node scripts/test-integration.mjs --browser"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.0.0",
    "eslint": "9.39.5",
    "globals": "^17.0.0",
    "playwright": "1.64.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "2.5.0"
    }
  }
}
