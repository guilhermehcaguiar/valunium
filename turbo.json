{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "HOST",
        "CORS_ORIGINS",
        "NEXT_PUBLIC_API_URL",
        "DATABASE_URL",
        "SESSION_SECRET",
        "WEB_ORIGIN",
        "MAIL_OUTBOX_DIR",
        "SMTP_URL",
        "SMTP_FROM",
        "API_INTERNAL_URL",
        "BRAPI_API_TOKEN",
        "BRAPI_DATA_USE_AUTHORIZED",
        "BRAPI_TERMS_REFERENCE",
        "QUOTE_TTL_MINUTES",
        "BRAPI_REQUEST_BUDGET",
        "BRAPI_PROVIDER_ENABLED",
        "BRAPI_MODE",
        "BRAPI_PERSONAL_USER_ID"
      ]
    }
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "infra/prisma/schema.prisma"
  ]
}
