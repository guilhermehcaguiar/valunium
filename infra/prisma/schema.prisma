// Stage 02: local identity, opaque sessions and owner-scoped portfolios.
// Domain reference remains preserved in docs/architecture/schema.conceptual.prisma.
// Financial fields in future stages must use Decimal @db.Decimal(38, 12).
generator client {
  provider = "prisma-client"
  output = "../../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model FoundationMetadata {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}


model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique @db.VarChar(254)
  name            String          @db.VarChar(100)
  passwordHash    String
  authVersion     Int             @default(0)
  locale          String          @default("pt-BR") @db.VarChar(10)
  timeZone        String          @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  portfolios      Portfolio[]
  catalogAssets   Asset[]
  passwordResets  PasswordReset[]
}

// Managed by express-session/connect-pg-simple. No raw recovery tokens are stored.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamptz(6)
  @@index([expire])
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
}

model Portfolio {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @db.Uuid
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name         String    @db.VarChar(100)
  description  String    @default("") @db.VarChar(1000)
  baseCurrency String    @default("BRL") @db.Char(3)
  isPrimary    Boolean   @default(false)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  @@index([ownerId, archivedAt, createdAt])
  events       LedgerEvent[]
  revisions    LedgerRevision[]
  historyIncomplete Boolean @default(false)
  // Partial primary uniqueness, BRL and lifecycle constraints live in the SQL migration.
}

model Asset {
  id String @id @default(uuid()) @db.Uuid
  creatorId String @db.Uuid
  creator User @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  ticker String @db.VarChar(20)
  name String @db.VarChar(150)
  assetClass String @db.VarChar(10)
  market String @default("B3")
  currency String @default("BRL")
  active Boolean @default(true)
  source String @db.VarChar(300)
  aliases AssetAlias[]
  events LedgerEvent[]
  changes AssetChange[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
model AssetAlias {
  id String @id @default(uuid()) @db.Uuid
  assetId String @db.Uuid
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  ticker String
  market String
  @@unique([market, ticker])
}
model AssetChange {
  id String @id @default(uuid()) @db.Uuid
  assetId String @db.Uuid
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  snapshot Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model LedgerEvent {
  id String @id @default(uuid()) @db.Uuid
  portfolioId String @db.Uuid
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  assetId String @db.Uuid
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  kind String @db.VarChar(10)
  date DateTime @db.Date
  sequence BigInt @unique @default(autoincrement())
  quantity Decimal @db.Decimal(38,12)
  unitPrice Decimal @db.Decimal(38,12)
  fees Decimal @db.Decimal(38,12)
  gross Decimal @db.Decimal(38,12)
  withholding Decimal @db.Decimal(38,12)
  note String @default("") @db.VarChar(1000)
  requestKey String @db.Uuid
  fingerprint String
  version Int @default(1)
  cancelled Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([portfolioId, requestKey])
  @@index([portfolioId, date, sequence])
  @@index([portfolioId, assetId])
}
model LedgerRevision {
  id String @id @default(uuid()) @db.Uuid
  portfolioId String @db.Uuid
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  actorId String @db.Uuid
  resourceId String @db.Uuid
  reason String
  before Json
  after Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([portfolioId, resourceId, createdAt])
}
