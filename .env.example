# Synthetic local example. Replace with your explicitly identified development DB.
DATABASE_URL="postgresql://valunium_dev:CHANGE_ME@localhost:5432/valunium_dev?schema=public"
# Generate at least 32 random bytes; never commit the resulting value.
# SESSION_SECRET=
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Optional absolute private directory OUTSIDE the repository (0700, messages 0600).
# MAIL_OUTBOX_DIR=/absolute/private/path
# Optional self-hosted SMTP. Required in production; never log these values.
# SMTP_URL=smtps://user:password@smtp.example.invalid:465
# SMTP_FROM=Valunium <no-reply@example.invalid>
# Backend only. No token is required for accounting or private manual references.
BRAPI_API_TOKEN=
QUOTE_TTL_MINUTES=60
# Conservative attempted requests in a rolling 35-day window, not provider billing quota.
BRAPI_REQUEST_BUDGET=10000
# Defaults OFF: separate permission must cover persistence, display and shared cache.
BRAPI_DATA_USE_AUTHORIZED=false
# Identifier for the separately obtained written provider authorization; not a secret/token.
BRAPI_TERMS_REFERENCE=
