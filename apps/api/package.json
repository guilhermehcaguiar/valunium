{
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "name": "@valunium/api",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && concurrently -k \"tsc -p tsconfig.json --watch\" \"node --watch --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@valunium/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0"
  }
}
